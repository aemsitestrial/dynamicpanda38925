{
  "definitions": [
    {
      "title": "XE Feature Cards",
      "id": "xe-feature-cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "XE Feature Cards",
              "filter": "xe-feature-cards",
              "model": "xe-feature-cards",
              "xe-card-1": {
                "sling:resourceType": "core/franklin/components/block/v1/block/item",
                "name":"Card 1",
                "model": "xe-card",
                "title": "Placeholder 1",
                "description": "Enter description here",
                "action": "https://www.google.com",
                "actionText": "View",
                "multi": true
              }
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "xe-feature-cards",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "description": "Lorem ipsum dolor sit amet",
          "required": true,
          "validation": {
            "minLength": 3,
            "maxLength": 10,
            "regExp": "^[A-Z0-9]+$",
            "customErrorMsg": "Promo code must be 3–10 uppercase letters or numbers."
          }
        },
        {
          "component": "richtext",
          "name": "subHeading",
          "value": "sub header",
          "label": "Sub heading",
          "valueType": "string"
        },
        {
          "component": "container",
          "name": "actions",
          "multi": true,
          "collapsible": false,
          "fields" : [{
            "component": "text",
            "name": "action"
          },
          {
            "component": "text",
            "name": "actionText"
          }]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "xe-feature-cards",
      "components": [
        "xe-card"
      ]
    }
  ]
}
