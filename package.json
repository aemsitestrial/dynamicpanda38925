{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "build:json": "npm-run-all -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"models/_component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"models/_component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"models/_component-filters.json\" -o \"component-filters.json\"",
    "copy:ignite:composition": "mkdir \"scripts/ignite/compositions\" && cp node_modules/@ignite/web/dist/compositions/**/*.js scripts/ignite/compositions",
    "copy:ignite:primitive": "mkdir \"scripts/ignite/primitives\" && cp node_modules/@ignite/web/dist/primitives/**/**/*.js scripts/ignite/primitives",
    "copy:ignite:themes": "mkdir -p scripts/ignite/themes && cp -r node_modules/@ignite/web/dist/themes/. scripts/ignite/themes",
    "copy:ignite:tokens": "mkdir -p scripts/ignite/tokens && cp -r node_modules/@ignite/web/dist/tokens/. scripts/ignite/tokens",
    "copy:ignite:utils": "mkdir \"scripts/ignite/utils\" && cp node_modules/@ignite/web/dist/utils/*.js scripts/ignite/utils",
    "bundle:ignite": "esbuild scripts/ignite/compositions/*.js scripts/ignite/primitives/*.js --bundle --format=esm --outbase=scripts/ignite --outdir=scripts/ignite/bundle",
    "copy:ignite:package": "rm -rf scripts/ignite && npm run copy:ignite:composition && npm run copy:ignite:primitive && npm run copy:ignite:themes && npm run copy:ignite:tokens && npm run copy:ignite:utils && npm run bundle:ignite",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.0",
    "esbuild": "^0.25.5",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-xwalk": "github:adobe-rnd/eslint-plugin-xwalk#v0.1.3",
    "husky": "9.1.1",
    "merge-json-cli": "1.0.4",
    "npm-run-all": "4.1.5",
    "stylelint": "16.21.1",
    "stylelint-config-standard": "38.0.0"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@ignite/web": "^0.34.0",
    "lit": "^3.3.3"
  }
}
